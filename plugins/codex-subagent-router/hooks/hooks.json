{
  "description": "Route unpinned native agent spawns through configured Jev Choice profiles.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^spawn_agent$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/launch_router\"",
            "commandWindows": "\"${PLUGIN_ROOT}\\scripts\\launch_router.cmd\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
